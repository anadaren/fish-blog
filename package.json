  "dependencies": {
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0"
},
  "devDependencies": {
    "firebase-tools": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anadaren/fish-blog.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/anadaren/fish-blog/issues"
